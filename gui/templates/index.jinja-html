<!-- templates/index.html -->
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Buch Matcher</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='home.css') }}">
    <script src="{{ url_for('static', filename='home.js') }}"></script>
</head>
<body>
    {% include "navbar.jinja-html" %}
    <div class="container">
        <h1>Buch Matcher - Inhaltsbasierrtes Filtern</h1>
        <form method="post" class="book-form">
            <label for="genres">Genres:</label>
            <input type="text" name="genres" id="genres" placeholder="z.B. Romanze, Thriller">

            <label for="author">Autor:</label>
            <input type="text" name="author" id="author" placeholder="z.B. J.K. Rowling">

            <label for="story_elements">Handlungselemente:</label>
            <input type="text" name="story_elements" id="story_elements" placeholder="z.B. Magie, Abenteuer">

            <label for="description">Beschreibung:</label>
            <textarea name="description" id="description" rows="3" placeholder="Beschreibe dein ideales Buch..."></textarea>

            <label for="pages">Seitenanzahl:</label>
            <input type="number" name="pages" id="pages" placeholder="z.B. 300" min="1" step="1">

            <label for="pages">Anzahl der Ergebnisse: </label>
            <input type="number" name="results" id="results" placeholder="z.B. 5" min="1" step="1"  max="100" required value="5">

            <input type="submit" value="Finden">
        </form>

        {% if results %}
            <h2>Top-Treffer</h2>
            <table class="results-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Titel</th>
                        <th>Autor</th>
                        <th>Beschreibung</th>
                        <th>Ähnlichkeit</th>
                    </tr>
                </thead>
                <tbody>
                {% for result in results %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        {% if result.title %}
                            <td>{{ result.title }}</td>
                        {% else %}
                            <td>-</td>
                        {% endif %}
                        {% if result.author %}
                            <td>{{ result.author }}</td>
                        {% else %}
                            <td>-</td>
                        {% endif %}
                        <td>
                            {% if result.description %}
                                {#Check if desc is > 100#}
                                {% if result.description|length > 300 %}
                                    <p>{{ result.description[:300] }}<span id="dots">...</span>
                                    <span id="read-more" style="display: none;">{{ result.description[300:] }}</span></p>
                                    <div class="more-button"><span>v</span></div>
                                {% else %}
                                    <p>{{ result.description }}</p>
                                {% endif %}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>{{ (result.similarity * 100) | round(2) }}%</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</body>
</html>
